{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/koreagorani/macro-monitor/blob/main/data/schema/weekly-report-output.schema.json",
  "title": "Weekly Report Output v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "asOf",
    "generatedAt",
    "presentation",
    "facts",
    "analysis",
    "warnings"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "2.0.0" },
    "asOf": { "type": "string", "format": "date" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "presentation": { "$ref": "#/$defs/presentation" },
    "facts": {
      "$ref": "https://github.com/koreagorani/macro-monitor/blob/main/data/schema/report-facts.schema.json"
    },
    "analysis": {
      "$ref": "https://github.com/koreagorani/macro-monitor/blob/main/data/schema/weekly-analysis-output.schema.json"
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/warning" }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "mandatoryDisclosure"],
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "mandatoryDisclosure": { "$ref": "#/$defs/text" }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": { "$ref": "#/$defs/text" }
      }
    }
  }
}
